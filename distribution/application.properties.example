# ============================================================
# Xiaovv / V380
# Configuration exemple
# ============================================================


# ============================================================
# RTSP
# ============================================================

rtsp.bind-address=0.0.0.0
rtsp.port=8555


# ============================================================
# API HTTP
# ============================================================

api.bind-address=0.0.0.0
api.port=8080

# Nom de la variable d'environnement.
# NE PAS mettre le jeton réel ici.
api.token-env=XIAOVV_API_TOKEN

# HTTPS facultatif en parallèle du HTTP local (Google Cast).
# Voir docs/HTTPS.md dans le dépôt.
api.https.enabled=false
# api.https.bind-address=0.0.0.0
# api.https.port=8443
# Chemin absolu recommandé ; utiliser / même sous Windows.
# api.https.key-store=/chemin/vers/certs/xiaovv.p12
# api.https.key-store-type=PKCS12
# api.https.key-store-password-env=XIAOVV_HTTPS_KEY_STORE_PASSWORD
# Sous Windows : saisie au premier lancement, puis stockage chiffre pour le compte courant.
# api.https.key-store-password-file=certs/xiaovv-password.dpapi


# ============================================================
# CAMÉRA EXEMPLE
# ============================================================

camera.example.enabled=true

# Facultatif : si absent, l'ID "example" devient le nom du stream.
camera.example.stream-name=example

camera.example.host=192.168.1.100
camera.example.port=8800

camera.example.device-id=XXXXXXXX
camera.example.username=XXXXXXXX

# Nom de la variable d'environnement.
# NE PAS mettre le mot de passe réel ici.
camera.example.password-env=XIAOVV_CAMERA_EXAMPLE_PASSWORD

camera.example.resolution=high
camera.example.reconnect-delay-ms=5000

# ============================================================
# MQTT
# ============================================================
#
# La configuration MQTT est volontairement séparée dans :
#
#     mqtt.properties
#
# Voir mqtt.properties.example.
#
# Les lanceurs de cette distribution définissent automatiquement
# XIAOVV_MQTT_CONFIG vers ce fichier externe.
# Le mot de passe reste dans une variable d'environnement, par exemple :
#
#     XIAOVV_MQTT_EXAMPLE_PASSWORD
#
